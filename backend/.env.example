# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Recommended: gemini-3-flash-preview)
DEFAULT_MODEL=gemini-3-flash-preview

# SQLite Database Connection URL
DATABASE_URL=sqlite:///./chatgpt.db

# Optional Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Twilio Credentials for Real SMS OTP Delivery
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Optional Fast2SMS Key for Indian SMS Delivery
# FAST2SMS_API_KEY=your_fast2sms_api_key
